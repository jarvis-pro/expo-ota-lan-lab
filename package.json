{
  "name": "expo-ota-lan-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "expo-updates 局域网 OTA 热更实验室：客户端(ota-demo) + 自托管更新服务器(server)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "server": "pnpm --filter expo-ota-lan-server start",
    "publish": "node server/publish.ts",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "postinstall": "node scripts/link-hoisted-modules.ts && node scripts/patch-maven-mirror.ts"
  }
}
